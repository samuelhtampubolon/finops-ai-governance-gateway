# FinOps & Hybrid AI Resource Governance Gateway Configuration

# Gateway Server
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Streamlit Cockpit
STREAMLIT_PORT=8501

# Security & Authentication
JWT_SECRET_KEY=finops-super-secure-production-ready-secret-key-9988-jwt-token
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Persistence & FinOps Ledger
DUCKDB_PATH=data/finops_ledger.duckdb

# Semantic Cache Configuration
SEMANTIC_SIMILARITY_THRESHOLD=0.92
CACHE_VECTOR_DIMENSIONS=128
DEFAULT_OVERHEAD_COGS_USD=0.00005

# Hybrid Model Routing & Unit Economics Pricing
LOCAL_MODEL_NAME=local-ollama-llama3
LOCAL_INPUT_COST_PER_1K=0.0001
LOCAL_OUTPUT_COST_PER_1K=0.0002

FRONTIER_MODEL_NAME=frontier-gpt5-claude
FRONTIER_INPUT_COST_PER_1K=0.015
FRONTIER_OUTPUT_COST_PER_1K=0.030

COMPLEXITY_ROUTING_THRESHOLD=0.65
DEFAULT_TARGET_GROSS_MARGIN_PCT=75.0
